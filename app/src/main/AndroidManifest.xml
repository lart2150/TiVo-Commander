<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!--
      The wifi permissions above imply a required android.hardware.wifi, and
      every app implies a required touchscreen.  Neither is true here, since
      all we need is some route to the TiVo.  Leaving them implied hides the
      app from ethernet-only and non-touch devices, Chrome OS among them.
    -->
    <uses-feature android:name="android.hardware.wifi" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen"
        android:required="false"/>
    <application
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:label="@string/app_name"
        android:allowBackup="true"
        android:theme="@style/Theme.TiVoCommander"
        android:usesCleartextTraffic="true"
        >
        <activity android:name=".NowShowing" android:label="@string/app_name" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".About" android:exported="false"/>
        <activity android:name=".Connect" android:exported="false"/>
        <activity android:name=".Discover" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity android:name=".ExploreTabs" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www3.tivo.com"
                    android:pathPattern="/tivo-tco/program/show.do" />
            </intent-filter>
        </activity>
        <activity android:name=".Guide" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity android:name=".Help" android:exported="false"/>
        <activity android:name=".MyShows" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity android:name=".Person"  android:exported="false"/>
        <!--
          Landscape: the TiVo's variant ladder is 16:9 throughout, topping out
          at 1280x720, so portrait is all letterbox.  Not exported: it is only
          reachable with a recording id this app already holds.
        -->
        <activity android:name=".Player"  android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"/>
        <activity android:name=".Remote"  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity android:name=".Search"  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity android:name=".SeasonPass" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity android:name=".Settings"  android:exported="false"/>
        <activity android:name=".SystemInfo" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity android:name=".SubscribeCollection"  android:exported="false"/>
        <activity android:name=".SubscribeOffer"  android:exported="false"/>
        <activity android:name=".ToDo"  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity android:name=".Upcoming"  android:exported="true"/>
        <activity android:name=".WontRecord" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
    </application>
</manifest>