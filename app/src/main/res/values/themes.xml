<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Locked to the dark AppCompat theme (not DayNight).  The layouts hardcode
       light-on-dark text colors throughout, and colorBackground is forced dark,
       so resolving to the light variant in day mode produced near-black text on
       a dark gray background. -->
  <style name="Theme.TiVoCommander" parent="Theme.AppCompat">
    <item name="android:colorBackground">@color/tivo_background</item>
    <item name="android:windowBackground">@color/tivo_background</item>
    <!-- Required by androidx.preference, which the Settings screen uses. -->
    <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
  </style>
</resources>
