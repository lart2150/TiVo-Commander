<!--
This file is necessary so that a ListActivity can call requestWindowFeature(),
which requires calling setContentView(), thus we need content.
-->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- RecyclerView replaces DragSortListView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/season_pass_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:padding="3dp" />

    <Button
        android:id="@+id/reorder_enable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reorder"
        style="?android:attr/buttonStyleSmall"
        android:onClick="reorderEnable" />

    <Button
        android:id="@+id/reorder_apply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Order"
        style="?android:attr/buttonStyleSmall"
        android:visibility="gone"
        android:onClick="reorderApply" />
</LinearLayout>

