<?xml version="1.0" encoding="utf-8"?>
<!-- A program in the guide grid.  The pressed state has to be drawn here:
     these blocks are plain views inside a scroller, not list rows, so they get
     no selector of their own from the theme. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <solid android:color="@color/guide_block_pressed" />
      <corners android:radius="2dp" />
      <stroke android:width="1dp" android:color="@color/guide_block_stroke" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/guide_block" />
      <corners android:radius="2dp" />
      <stroke android:width="1dp" android:color="@color/guide_block_stroke" />
    </shape>
  </item>
</selector>
