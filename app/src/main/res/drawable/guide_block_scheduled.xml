<?xml version="1.0" encoding="utf-8"?>
<!-- A program the box is going to record.  The colour is a second carrier of
     that fact, never the only one: the block also gets a check mark and says
     so in its content description, for anyone who cannot pick the tint out. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <solid android:color="@color/guide_block_scheduled_pressed" />
      <corners android:radius="2dp" />
      <stroke android:width="1dp" android:color="@color/guide_block_stroke" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/guide_block_scheduled" />
      <corners android:radius="2dp" />
      <stroke android:width="1dp" android:color="@color/guide_block_stroke" />
    </shape>
  </item>
</selector>
